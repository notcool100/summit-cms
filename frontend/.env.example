# Base URL of the SummitCms.Api backend (no trailing slash).
# Used server-side (SSR load functions, form actions) - never exposed as a client bundle var beyond
# what PUBLIC_ prefix normally implies, since all admin calls happen in +page.server.ts/+server.ts.
PUBLIC_API_BASE_URL=http://localhost:5167

# Canonical public URL of this site (no trailing slash). Used for canonical/OpenGraph tags and the
# generated sitemap.xml, so search engines and social crawlers see the real domain, not localhost.
PUBLIC_SITE_URL=https://www.summit-is.com.au
